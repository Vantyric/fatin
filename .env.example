# ==============================================================================
# "فَطِن" (Fatin) Environment Variables Configuration
# ==============================================================================

# Site URL (Canonical domain for SEO, OG images, and OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://fatin.iq

# Supabase Authentication & Database
# Check Supabase project settings -> API for these credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Google Gemini API (Two-tier Intelligent Engine)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_DEEP=gemini-3.5-flash-lite
ENABLE_DEEP_PASS=true
ENABLE_SEARCH_GROUNDING=false

# Link Intelligence
ENABLE_UNSHORTEN=true
ENABLE_RDAP=true

# Salt for SHA-256 IP & Guest Usage Rate Limiting
# Use a random 32+ character string
RATE_LIMIT_SALT=fatin-iraq-secure-production-salt-change-me

# Optional: Google Safe Browsing API v4
# Get a key from Google Cloud Console with Safe Browsing API enabled
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: Cloudflare Turnstile Bot Defense (for guests)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
